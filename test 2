        if Data.MinimizeButton ~= false then
            local ToggleButton = Instances:Create("ImageButton", {
                Parent = Library.Holder.Instance,
                Name = "ToggleButton",
                Size = UDim2New(0, 70, 0, 70),
                Position = UDim2New(0.03, 0, 0.4, 0),
