            if type(hsv) ~= "table" then return end
            Colorpicker.Hue = MathClamp(hsv[1] or 0, 0, 1)
            Colorpicker.Sat = MathClamp(hsv[2] or 0, 0, 1)
            Colorpicker.Vib = MathClamp(hsv[3] or 0, 0, 1)
