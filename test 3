        end
        if self.UnusedHolder then 
            self.UnusedHolder:Clean()
        end

        local lighting = game:GetService("Lighting")
        local blur = lighting:FindFirstChild("Midnight_BadgeBlur")
        if blur then blur:Destroy() end

        TableClear(activeTweens)
